APP_NAME=FurnitureStore
# Placeholder rỗng để `php artisan key:generate` điền key sau khi cp .env.example .env
APP_KEY=
APP_URL=http://localhost:8000
DB_CONNECTION=mysql
# Giá trị mặc định cho Docker Compose (service "db").
# Khi chạy local (XAMPP) hoặc CI, đè DB_HOST/DB_USERNAME/DB_PASSWORD trong .env.
DB_HOST=db
DB_PORT=3306
DB_DATABASE=furniture
DB_USERNAME=furniture
DB_PASSWORD=secret
